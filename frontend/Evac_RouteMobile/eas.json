{
  "cli": {
    "version": ">= 18.0.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_ENV": "development"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://evacroute.app/api",
        "EXPO_PUBLIC_WEB_URL": "https://evacroute.app",
        "EXPO_PUBLIC_ECHO_HOST": "evacroute.app",
        "EXPO_PUBLIC_ECHO_PORT": "443",
        "EXPO_PUBLIC_ECHO_SCHEME": "https",
        "EXPO_PUBLIC_REVERB_APP_KEY": "evac-route-key",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a",
        "reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://evacroute.app/api",
        "EXPO_PUBLIC_WEB_URL": "https://evacroute.app",
        "EXPO_PUBLIC_ECHO_HOST": "evacroute.app",
        "EXPO_PUBLIC_ECHO_PORT": "443",
        "EXPO_PUBLIC_ECHO_SCHEME": "https",
        "EXPO_PUBLIC_REVERB_APP_KEY": "evac-route-key"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
