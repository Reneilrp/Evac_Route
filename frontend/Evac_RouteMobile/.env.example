# Mapbox Tokens
MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN_HERE
MAPBOX_DOWNLOADS_TOKEN=sk.YOUR_MAPBOX_SECRET_DOWNLOADS_TOKEN_HERE
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.YOUR_MAPBOX_SECRET_DOWNLOADS_TOKEN_HERE

# API & WebSockets Configuration
# Note: Use http://10.0.2.2:8000/api for Android Emulator or your PC's local IP (e.g. http://192.168.1.X:8000/api) for physical devices
API_BASE_URL=http://10.0.2.2:8000/api

# Laravel Reverb WebSockets Server Settings
REVERB_APP_KEY=evac-route-key
